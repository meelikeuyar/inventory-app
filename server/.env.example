# Server
PORT=5000
NODE_ENV=development

# MongoDB (update credentials to match docker-compose)
MONGODB_URI=mongodb://inventoryAdmin:YOUR_MONGO_PASSWORD@localhost:27017/inventory-app?authSource=admin

# Docker Compose credentials (used by docker-compose.yml)
MONGO_USER=inventoryAdmin
MONGO_PASSWORD=
REDIS_PASSWORD=

# JWT — Generate strong random secrets before production!
# Example: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# Redis (optional — cache disabled if not set)
REDIS_URL=redis://localhost:6379

# Seed (REQUIRED for npm run seed — no default fallback)
SEED_PASSWORD=

# Metrics endpoint protection (optional — if not set, requires admin auth)
METRICS_TOKEN=